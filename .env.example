# Production runtime configuration. Do not commit a real .env file.
PORT=8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
DRE_AGENT_TOKEN=
DRE_ALLOW_SHELL_EXECUTION=false
DRE_STATE_DB_PATH=/workspace/dre-copilot/state.sqlite3
DRE_HISTORY_MAX_MESSAGES=40
DRE_HISTORY_MAX_CHARS=30000
DRE_SHELL_TIMEOUT_SECONDS=30
DRE_SHELL_MAX_OUTPUT_CHARS=20000